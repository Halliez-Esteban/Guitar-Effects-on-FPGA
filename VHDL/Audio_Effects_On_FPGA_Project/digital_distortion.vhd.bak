LIBRARY ieee;
USE ieee.std_logic_1164.ALL;
USE ieee.numeric_std.ALL;

entity digital_distortion is
	port
	(
		-- Clock
		CLOCK_50 : in std_logic;
		clock_48kHz : in std_logic;
		
		-- Audio Signal
		audio_in : in std_logic_vector(15 downto 0);
		audio_out : out std_logic_vector(15 downto 0);
		
		--Button to modify counter value
		KEY : IN STD_LOGIC_VECTOR(3 DOWNTO 0);
		effect_counter : out std_logic_vector(4 downto 0)
	);
end digital_distortion;

architecture digital_distortion_circuit of digital_distortion is

	 --Detecting button being pressed
	 signal counter50k : std_logic_vector(10 downto 0) := (others => '0'); --Dividing the MCLK by 1000
	 signal bitRegister0 : STD_LOGIC_VECTOR(3 DOWNTO 0); --Registers storing last 4 values of the button
	 signal bitRegister1 : STD_LOGIC_VECTOR(3 DOWNTO 0);

	 signal echantillon : signed(15 downto 0);

    signal sortie_bitcrushed   : signed(15 downto 0);
    signal counter             : integer range 0 to 20 := 0;
	 signal max_counter			 : integer range 0 to 20 := 0;
	 signal counter_vector : std_logic_vector(4 downto 0) := std_logic_vector(to_unsigned(0, 5));
	 
	 --Modifying counter 
	 signal increase_counter,decrease_counter : std_logic;
	 
    -- Coefficients Q15 (plus simple pour multiplier du signé)
    -- 0.5 = 16384 | 1.0 = 32767
    signal K    : signed(15 downto 0) := to_signed(26214, 16); -- ~0.8
    signal Kinv : signed(15 downto 0) := to_signed(6554, 16); -- ~0.2
    
    signal prod_crushed : signed(31 downto 0);
    signal prod_dry     : signed(31 downto 0);

begin
	 
	 effect_counter <= counter_vector;
	 
	 PROCESS(CLOCK_50)
	 BEGIN
	
	 --Detecting clock rising edge
		 IF rising_edge(CLOCK_50) THEN
				
		 --Dividing MCLK by 1000 with a counter
			
		  	 IF (unsigned(counter50k) = to_unsigned(999, counter50k'length)) THEN 
				 counter50k <=(others => '0');
				
				 --Sampling at 50kHz both buttons
				
				 FOR i in 1 TO 3 LOOP
				 bitRegister0(i) <= bitRegister0(i-1);
				 bitRegister1(i) <= bitRegister1(i-1);
				 END LOOP;
				
				 bitRegister0(0) <= KEY(2);
				 bitRegister1(0) <= KEY(3);
				 
				 --Press Detected
				
				 IF bitRegister0 = "0011" THEN decrease_counter <= '0' ;
				 ELSE decrease_counter <= '1';
				 END IF;
				
				 IF bitRegister1 = "0011" THEN increase_counter <= '0';
				 ELSE increase_counter <= '1';
				 END IF;
				
				
			 ELSE counter50k <= std_logic_vector(unsigned(counter50k) + 1);
			 END IF;
		 	
		 END IF;
		
	 END PROCESS;
	 
    process(clock_48kHz)
	 
    variable temp_bits10 : signed(9 downto 0);
	 variable temp_bits7 : signed(6 downto 0);
	 variable temp_bits4 : signed(3 downto 0);
	 
    begin
        if rising_edge(clock_48kHz) then
		  
				-- Counter Value Modifying Logic
				
				if(increase_counter='0' and max_counter<20)then max_counter <= max_counter +1; counter_vector <= std_logic_vector(to_unsigned(max_counter, 5));
				elsif(decrease_counter='0' and max_counter > 0)then max_counter <= max_counter -1; counter_vector <= std_logic_vector(to_unsigned(max_counter, 5));
            end if;
				
            -- 1. SAMPLE & HOLD
            if (counter = 0) then
                echantillon <= signed(audio_in);
                counter <= max_counter;
            else
                counter <= counter - 1;
            end if;

            -- 2. BITCRUSHING (Keeping MSBs)
				if(max_counter <7)then 
				
					temp_bits10 := echantillon(15 downto 6);
					-- Rounding quantization noise (Smoother)
					if (echantillon(5) = '1' and temp_bits10 /= "0111111111") then 
						temp_bits10 := temp_bits10 + 1;
					end if;
					sortie_bitcrushed <= temp_bits10 & "000000";
					
				elsif(max_counter <12)then 
				
					temp_bits7 := echantillon(15 downto 9);
					-- Rounding quantization noise (Smoother)
					if (echantillon(8) = '1' and temp_bits7 /= "0111111") then 
						temp_bits7 := temp_bits7 + 1;
					end if;
					sortie_bitcrushed <= temp_bits7 & "000000000";
					
				else	
				
					temp_bits4 := echantillon(15 downto 12);
					-- Rounding quantization noise (Smoother)
					if (echantillon(11) = '1' and temp_bits4 /= "0111") then 
						temp_bits4 := temp_bits4 + 1;
					end if;
					sortie_bitcrushed <= temp_bits4 & "000000000000";
					
				end if;
            
           
				--Output
            audio_out <= std_logic_vector(sortie_bitcrushed(15 downto 0));
            
        end if;
    end process;

end digital_distortion_circuit;